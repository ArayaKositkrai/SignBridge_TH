# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (ห้าม commit .env)

# database (Supabase > Project Settings > Database > Connection string)
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres

# กุญแจเซ็น session ของระบบล็อกอิน สุ่มใหม่ด้วย:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_SECRET=

# อีเมล Google ที่ล็อกอินแล้วได้เป็นแอดมิน คั่นด้วยจุลภาค
# (หรือสมัครด้วยอีเมลแล้วสั่ง: python -m app.scripts.set_role you@example.com admin)
ADMIN_EMAILS=

# Google login: Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
#   Authorized redirect URI: http://localhost:8000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# LINE login: LINE Developers Console > LINE Login channel
#   Callback URL: http://localhost:8000/api/auth/line/callback
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=

# ตอนขึ้นเซิร์ฟเวอร์จริง
# PUBLIC_API_URL=https://api.example.com
# CORS_ORIGINS=https://example.com
# COOKIE_SECURE=1
